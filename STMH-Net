# STMH-Net - Ablation: remove HWDDown and DySample
# Keep only heterogeneous prediction-head enhancements: STP Block + MA Head

nc: 1
ch: 3
depth_multiple: 0.33
width_multiple: 0.50

anchors:
  - [11,15, 20,16, 18,42]
  - [60,18, 34,45, 57,33]
  - [67,69, 137,99, 255,220]

backbone:
  [
    [-1, 1, Conv, [64, 6, 2, 2]],

    [-1, 1, Conv, [128, 3, 2]],
    [-1, 3, C3, [128]],

    [-1, 1, Conv, [256, 3, 2]],
    [-1, 6, C3, [256]],

    [-1, 1, Conv, [512, 3, 2]],
    [-1, 9, C3, [512]],

    [-1, 1, Conv, [1024, 3, 2]],
    [-1, 3, C3, [1024]],
    [-1, 1, SPPF, [1024, 5]],
  ]

head:
  [
    [-1, 1, Conv, [512, 1, 1]],
    [-1, 1, nn.Upsample, [None, 2, "nearest"]],
    [[-1, 6], 1, Concat, [1]],
    [-1, 3, C3, [512, False]],

    [-1, 1, Conv, [256, 1, 1]],
    [-1, 1, nn.Upsample, [None, 2, "nearest"]],
    [[-1, 4], 1, Concat, [1]],
    [-1, 3, C3, [256, False]],

    # Spatial-Texture Perception Block for the high-resolution prediction branch
    [-1, 1, STPBlock, [256, 8, 0.3, 0.5, 0.5]],

    [-1, 1, Conv, [256, 3, 2]],
    [[-1, 14], 1, Concat, [1]],
    [-1, 3, C3, [512, False]],

    # Morphology-Aware Head for the medium-resolution prediction branch
    [-1, 1, MAHead, [512, 0.5, 0.5]],

    [21, 1, Conv, [512, 3, 2]],
    [[-1, 10], 1, Concat, [1]],
    [-1, 3, C3, [1024, False]],

    [[18, 22, 25], 1, Detect, [nc, anchors]],
  ]
