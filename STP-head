import torch
import torch.nn as nn


def autopad(k, p=None, d=1):
    if p is not None:
        return p
    if isinstance(k, int):
        return d * (k - 1) // 2
    return tuple(d * (x - 1) // 2 for x in k)


class ConvBNAct(nn.Module):
    """Convolution-BN-Activation block."""
    def __init__(self, c1, c2, k=1, s=1, p=None, d=1, g=1, act=True):
        super().__init__()
        self.conv = nn.Conv2d(
            c1, c2, k, s,
            autopad(k, p, d),
            dilation=d,
            groups=g,
            bias=False
        )
        self.bn = nn.BatchNorm2d(c2)
        self.act = nn.SiLU(inplace=True) if act else nn.Identity()

    def forward(self, x):
        return self.act(self.bn(self.conv(x)))


class DualPoolingChannelAttention(nn.Module):
    """
    Dual-Pooling Channel Attention (DPCA).

    DPCA combines average-pooled and max-pooled channel descriptors
    to preserve both global response distribution and salient target cues.
    It is used in the STP Block to enhance weak small-ship responses
    in the high-resolution prediction branch.
    """
    def __init__(self, channels, reduction=8, lam=0.5):
        super().__init__()
        hidden_channels = max(channels // reduction, 8)

        self.avg_pool = nn.AdaptiveAvgPool2d(1)
        self.max_pool = nn.AdaptiveMaxPool2d(1)

        self.channel_reduce = nn.Conv2d(
            channels, hidden_channels, kernel_size=1, bias=True
        )
        self.activation = nn.ReLU(inplace=True)
        self.channel_expand = nn.Conv2d(
            hidden_channels, channels, kernel_size=1, bias=True
        )
        self.sigmoid = nn.Sigmoid()

        self.attention_scale = lam

    def forward(self, x):
        avg_descriptor = self.avg_pool(x)
        max_descriptor = self.max_pool(x)

        dual_descriptor = avg_descriptor + max_descriptor

        attention_weight = self.channel_reduce(dual_descriptor)
        attention_weight = self.activation(attention_weight)
        attention_weight = self.channel_expand(attention_weight)
        attention_weight = self.sigmoid(attention_weight)

        return x + self.attention_scale * (x * attention_weight)


class SpatialTexturePerceptionBlock(nn.Module):
    """
    Spatial-Texture Perception Block (STP Block).

    The STP Block is designed for the high-resolution prediction branch.
    It enhances shallow texture representation and directional context
    modeling for weak small SAR ship targets.

    Structure:
        1) Spatial-texture stem
        2) Point-wise feature branch
        3) Local texture branch
        4) Directional context branch
        5) Multi-branch feature fusion
        6) Dual-Pooling Channel Attention
        7) Spatial-texture integration
        8) Residual enhancement
    """
    def __init__(
        self,
        c1,
        c2=None,
        reduction=8,
        alpha=0.3,
        lam=0.5,
        branch_ratio=0.5
    ):
        super().__init__()

        c2 = c1 if c2 is None else c2
        branch_channels = max(int(c2 * branch_ratio), 16)

        # Residual enhancement scale
        self.residual_scale = alpha

        # Spatial-texture stem
        self.spatial_texture_stem = ConvBNAct(c1, c2, k=3, s=1)

        # Point-wise feature branch
        self.pointwise_branch = ConvBNAct(c2, branch_channels, k=1, s=1)

        # Local texture branch
        self.local_texture_branch = ConvBNAct(c2, branch_channels, k=3, s=1)

        # Directional context branch
        self.directional_context_branch = nn.Sequential(
            ConvBNAct(c2, branch_channels, k=(1, 3), s=1),
            ConvBNAct(branch_channels, branch_channels, k=(3, 1), s=1)
        )

        # Multi-branch feature fusion
        self.multi_branch_fusion = ConvBNAct(branch_channels * 3, c2, k=1, s=1)

        # Dual-Pooling Channel Attention
        self.dpca = DualPoolingChannelAttention(
            c2,
            reduction=reduction,
            lam=lam
        )

        # Spatial-texture integration
        self.spatial_texture_integration = ConvBNAct(c2, c2, k=3, s=1)

    def forward(self, x):
        stem_feature = self.spatial_texture_stem(x)

        pointwise_feature = self.pointwise_branch(stem_feature)
        local_texture_feature = self.local_texture_branch(stem_feature)
        directional_context_feature = self.directional_context_branch(stem_feature)

        fused_feature = torch.cat(
            [
                pointwise_feature,
                local_texture_feature,
                directional_context_feature
            ],
            dim=1
        )

        fused_feature = self.multi_branch_fusion(fused_feature)
        fused_feature = self.dpca(fused_feature)
        fused_feature = self.spatial_texture_integration(fused_feature)

        return stem_feature + self.residual_scale * fused_feature


# Recommended aliases for model YAML or parser compatibility
STPBlock = SpatialTexturePerceptionBlock
DPCA = DualPoolingChannelAttention
